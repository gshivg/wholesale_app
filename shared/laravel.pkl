// Renders config.pkl as a Laravel config file: server/config/shared.php
import "config.pkl" as cfg

local function esc(s: String): String = s.replaceAll("\\", "\\\\").replaceAll("'", "\\'")

local function pad(n: Int): String = "".padStart(n * 4, " ")

local function php(v: Any, depth: Int): String =
  if (v is String) "'\(esc(v))'"
  else if (v is Boolean || v is Number) v.toString()
  else if (v is Listing || v is List)
    "[\n" + v.toList().map((e) -> "\(pad(depth + 1))\(php(e, depth + 1)),\n").join("") + "\(pad(depth))]"
  else
    "[\n" + v.toMap().entries.map((e) -> "\(pad(depth + 1))'\(esc(e.key.toString()))' => \(php(e.value, depth + 1)),\n").join("") + "\(pad(depth))]"

output {
  text = "<?php\n\n// GENERATED by shared/laravel.pkl from shared/config.pkl — do not edit by hand.\n\nreturn \(php(cfg, 0));\n"
}
